-- =========================================================
-- PARKCONTROL
-- CREACIÓN COMPLETA DE LA BASE DE DATOS
-- =========================================================

-- ATENCIÓN: ELIMINA EL ESQUEMA ANTERIOR Y SUS TABLAS
DROP SCHEMA IF EXISTS parkingapp CASCADE;

CREATE SCHEMA parkingapp AUTHORIZATION postgres;


-- =========================================================
-- 1. TABLA ABONADO
-- =========================================================

CREATE TABLE parkingapp.abonado (

    id INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,

    matricula VARCHAR(255) NOT NULL,

    fecha_ini DATE NOT NULL,

    fecha_fin DATE NOT NULL,

    CONSTRAINT abonado_fechas_check
    CHECK (fecha_fin >= fecha_ini)

);


-- =========================================================
-- 2. TABLA PLAZA
-- =========================================================

CREATE TABLE parkingapp.plaza (

    id INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,

    estado VARCHAR(255) NOT NULL,

    numero INTEGER NOT NULL,

    planta INTEGER NOT NULL,

    tipo VARCHAR(255) NOT NULL,

    CONSTRAINT plaza_numero_unique
    UNIQUE (numero),

    CONSTRAINT plaza_planta_check
    CHECK (planta IN (-1, -2, -3)),

    CONSTRAINT plaza_estado_check
    CHECK (estado IN ('libre', 'ocupada', 'bloqueada')),

    CONSTRAINT plaza_tipo_check
    CHECK (tipo IN ('normal', 'movilidad reducida', 'cargador electrico'))

);


-- =========================================================
-- 3. TABLA PROMOCION
-- =========================================================

CREATE TABLE parkingapp.promocion (

    id INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,

    nombre VARCHAR(255) NOT NULL,

    tipo VARCHAR(255) NOT NULL,

    min_descuento INTEGER NOT NULL,

    CONSTRAINT promocion_min_descuento_check
    CHECK (min_descuento > 0)

);


-- =========================================================
-- 4. TABLA TARIFA
-- =========================================================

CREATE TABLE parkingapp.tarifa (

    id INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,

    min_cortesia INTEGER NOT NULL,

    precio_por_min NUMERIC(8,2) NOT NULL,

    tope_maximo NUMERIC(8,2) NOT NULL,

    fecha_aplica DATE NOT NULL,

    CONSTRAINT tarifa_min_cortesia_check
    CHECK (min_cortesia >= 0),

    CONSTRAINT tarifa_precio_check
    CHECK (precio_por_min >= 0),

    CONSTRAINT tarifa_tope_check
    CHECK (tope_maximo >= 0)

);


-- =========================================================
-- 5. TABLA USUARIO
-- =========================================================

CREATE TABLE parkingapp.usuario (

    id INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,

    nombre VARCHAR(255) NOT NULL,

    "contraseña" VARCHAR(255) NOT NULL

);


-- =========================================================
-- 6. TABLA ABONADO_USUARIO
-- =========================================================

CREATE TABLE parkingapp.abonado_usuario (

    id INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,

    id_abonado INTEGER NOT NULL,

    id_usuario INTEGER NOT NULL,

    CONSTRAINT abonado_usuario_id_abonado_foreign
    FOREIGN KEY (id_abonado)
    REFERENCES parkingapp.abonado(id),

    CONSTRAINT abonado_usuario_id_usuario_foreign
    FOREIGN KEY (id_usuario)
    REFERENCES parkingapp.usuario(id),

    CONSTRAINT abonado_usuario_unique
    UNIQUE (id_abonado, id_usuario)

);


-- =========================================================
-- 7. TABLA TICKETS
-- =========================================================

CREATE TABLE parkingapp.tickets (

    id INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,

    matricula VARCHAR(255) NOT NULL,

    hora_entrada TIMESTAMP(0) WITHOUT TIME ZONE NOT NULL,

    hora_salida TIMESTAMP(0) WITHOUT TIME ZONE,

    estado VARCHAR(255) NOT NULL,

    minutos INTEGER NOT NULL DEFAULT 0,

    descuento NUMERIC(8,2) NOT NULL DEFAULT 0,

    importe_descuento NUMERIC(8,2) NOT NULL DEFAULT 0,

    importe NUMERIC(8,2) NOT NULL DEFAULT 0,

    numero_plaza INTEGER NOT NULL,

    id_tarifa INTEGER NOT NULL,

    id_abonado INTEGER,

    CONSTRAINT tickets_numero_plaza_foreign
    FOREIGN KEY (numero_plaza)
    REFERENCES parkingapp.plaza(numero),

    CONSTRAINT tickets_id_tarifa_foreign
    FOREIGN KEY (id_tarifa)
    REFERENCES parkingapp.tarifa(id),

    CONSTRAINT tickets_id_abonado_foreign
    FOREIGN KEY (id_abonado)
    REFERENCES parkingapp.abonado(id),

    CONSTRAINT tickets_estado_check
    CHECK (estado IN ('ACTIVO', 'PAGADO')),

    CONSTRAINT tickets_minutos_check
    CHECK (minutos >= 0),

    CONSTRAINT tickets_descuento_check
    CHECK (descuento >= 0),

    CONSTRAINT tickets_importe_descuento_check
    CHECK (importe_descuento >= 0),

    CONSTRAINT tickets_importe_check
    CHECK (importe >= 0)

);


-- =========================================================
-- 8. TABLA DESCUENTO
-- RELACIÓN N:M ENTRE TICKETS Y PROMOCION
-- =========================================================

CREATE TABLE parkingapp.descuento (

    id INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,

    id_ticket INTEGER NOT NULL,

    id_promocion INTEGER NOT NULL,

    minutos_aplicados INTEGER NOT NULL,

    fecha_aplicacion TIMESTAMP(0) WITHOUT TIME ZONE
    NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT descuento_ticket_foreign
    FOREIGN KEY (id_ticket)
    REFERENCES parkingapp.tickets(id),

    CONSTRAINT descuento_promocion_foreign
    FOREIGN KEY (id_promocion)
    REFERENCES parkingapp.promocion(id),

    CONSTRAINT descuento_ticket_promocion_unique
    UNIQUE (id_ticket, id_promocion),

    CONSTRAINT descuento_minutos_check
    CHECK (minutos_aplicados > 0)

);


-- =========================================================
-- 9. ÍNDICE PARA EVITAR DOS TICKETS ACTIVOS
-- DE UNA MISMA MATRÍCULA
-- =========================================================

CREATE UNIQUE INDEX tickets_matricula_activa_unique
ON parkingapp.tickets(matricula)
WHERE estado = 'ACTIVO';


