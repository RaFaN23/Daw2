-- =========================================================
-- CREACIÓN DE TABLAS parkingapp
-- =========================================================

CREATE TABLE plaza(
    id INTEGER NOT NULL,
    estado VARCHAR(255) NOT NULL,
    numero INTEGER NOT NULL,
    planta INTEGER NOT NULL,
    tipo VARCHAR(255) NOT NULL
);

ALTER TABLE plaza ADD PRIMARY KEY(id);

-- El número de plaza debe ser único porque tickets lo referencia
ALTER TABLE plaza
ADD CONSTRAINT plaza_numero_unique UNIQUE(numero);


CREATE TABLE tickets(
    id INTEGER NOT NULL,
    matricula VARCHAR(255) NOT NULL,
    hora_entrada TIMESTAMP(0) WITHOUT TIME ZONE NOT NULL,
    hora_salida TIMESTAMP(0) WITHOUT TIME ZONE NOT NULL,
    estado VARCHAR(255) NOT NULL,
    minutos INTEGER NOT NULL,
    descuento DECIMAL(8, 2) NOT NULL,
    importe_descuento DECIMAL(8, 2) NOT NULL,
    importe DECIMAL(8, 2) NOT NULL,
    numero_plaza INTEGER NOT NULL,
    id_tarifa INTEGER NOT NULL,
    id_abonado INTEGER NOT NULL,
    id_promocion INTEGER NOT NULL
);

ALTER TABLE tickets ADD PRIMARY KEY(id);


CREATE TABLE tarifa(
    id INTEGER NOT NULL,
    min_cortesia INTEGER NOT NULL,
    precio_por_min DECIMAL(8, 2) NOT NULL,
    tope_maximo DECIMAL(8, 2) NOT NULL,
    fecha_aplica DATE NOT NULL
);

ALTER TABLE tarifa ADD PRIMARY KEY(id);


CREATE TABLE promocion(
    id INTEGER NOT NULL,
    nombre VARCHAR(255) NOT NULL,
    tipo VARCHAR(255) NOT NULL,
    min_descuento INTEGER NOT NULL
);

ALTER TABLE promocion ADD PRIMARY KEY(id);


CREATE TABLE abonado(
    id INTEGER NOT NULL,
    matricula VARCHAR(255) NOT NULL,
    fecha_ini DATE NOT NULL,
    fecha_fin DATE NOT NULL
);

ALTER TABLE abonado ADD PRIMARY KEY(id);


CREATE TABLE usuario(
    id INTEGER NOT NULL,
    nombre VARCHAR(255) NOT NULL,
    contraseña VARCHAR(255) NOT NULL
);

ALTER TABLE usuario ADD PRIMARY KEY(id);


CREATE TABLE abonado_usuario(
    id INTEGER NOT NULL,
    id_abonado INTEGER NOT NULL,
    id_usuario INTEGER NOT NULL
);

ALTER TABLE abonado_usuario ADD PRIMARY KEY(id);


-- =========================================================
-- CLAVES FORÁNEAS
-- =========================================================

ALTER TABLE tickets
ADD CONSTRAINT tickets_numero_plaza_foreign
FOREIGN KEY(numero_plaza)
REFERENCES plaza(numero);


ALTER TABLE tickets
ADD CONSTRAINT tickets_id_abonado_foreign
FOREIGN KEY(id_abonado)
REFERENCES abonado(id);


ALTER TABLE tickets
ADD CONSTRAINT tickets_id_tarifa_foreign
FOREIGN KEY(id_tarifa)
REFERENCES tarifa(id);


ALTER TABLE tickets
ADD CONSTRAINT tickets_id_promocion_foreign
FOREIGN KEY(id_promocion)
REFERENCES promocion(id);


ALTER TABLE abonado_usuario
ADD CONSTRAINT abonado_usuario_id_usuario_foreign
FOREIGN KEY(id_usuario)
REFERENCES usuario(id);


ALTER TABLE abonado_usuario
ADD CONSTRAINT abonado_usuario_id_abonado_foreign
FOREIGN KEY(id_abonado)
REFERENCES abonado(id);


